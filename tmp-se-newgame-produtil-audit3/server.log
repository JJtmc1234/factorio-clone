local specialist_terms={"astronomic","biological","energy%-science","material%-science","deep%-space"}
local function is_science_name(n)
  for _,p in pairs(patterns) do if string.find(n,p) then return true end end
  return false
end
local function is_specialist(n)
  for _,p in pairs(specialist_terms) do if string.find(n,p) then return true end end
  return false
end
for _,f in pairs(game.forces) do
  local fr={name=f.name,rockets_launched=f.rockets_launched or 0,items={},researched_specialist={}}
  for n,_ in pairs(game.item_prototypes) do
    if is_science_name(n) then
      local o=0;local i=0
      pcall(function() o=f.item_production_statistics.get_output_count(n) end)
      pcall(function() i=f.item_production_statistics.get_input_count(n) end)
      if o>0 or i>0 then fr.items[n]={output=o,input=i} end
    end
  end
  for n,t in pairs(f.technologies) do
    if t.researched and is_specialist(n) then table.insert(fr.researched_specialist,n) end
  end
  table.sort(fr.researched_specialist)
  table.insert(out.forces,fr)
end
for _,p in pairs(game.players) do table.insert(out.players,{name=p.name,force=p.force.name,surface=p.surface and p.surface.name or nil,position=p.position}) end
for _,s in pairs(game.surfaces) do
  local sr={name=s.name,index=s.index,chunks=0,player_entities=0,science_recipes={}}
  for _ in s.get_chunks() do sr.chunks=sr.chunks+1 end
  for _,f in pairs(game.forces) do
    if f.name~="enemy" and f.name~="neutral" then
      local ok,c=pcall(function() return s.count_entities_filtered{force=f} end)
      if ok then sr.player_entities=sr.player_entities+c end
    end
  end
  local ok,entities=pcall(function() return s.find_entities_filtered{type={"assembling-machine","furnace","rocket-silo","lab"}} end)
  if ok then
    for _,e in pairs(entities) do
      local okr,r=pcall(function() return e.get_recipe() end)
      if okr and r and is_science_name(r.name) then
        sr.science_recipes[r.name]=(sr.science_recipes[r.name] or 0)+1
        out.science_recipes[r.name]=(out.science_recipes[r.name] or 0)+1
      end
    end
  end
  table.insert(out.surfaces,sr)
end
game.write_file("jj-se-audit.json", game.table_to_json(out), false)".

81%92%EF%BD%9Clazy_kojocho%EF%BD%9Cnote%EF%BC%88%E3%83%8E%E3%83%BC%E3%83%88%EF%BC%89","line_share_url":"https://line.naver.jp/R/msg/text/?SE+47h%3A+%E3%81%AF%E3%81%98%E3%82%81%E3%81%A6%E3%81%AE%E8%A6%B3%E6%B8%AC%E8%A1%9B%E6%98%9F%E6%89%93%E3%81%A1%E4%B8%8A%E3%81%92%EF%BD%9Clazy_kojocho%EF%BD%9Cnote%EF%BC%88%E3%83%8E%E3%83%BC%E3%83%88%EF%BC%89%0Ahttps://note.com/lazy_kojocho/n/ncc796712f232","twitter_share_url":"https://twitter.com/intent/tweet?url=https://note.com/lazy_kojocho/n/ncc796712f232&text=SE+47h%3A+%E3%81%AF%E3%81%98%E3%82%81%E3%81%A6%E3%81%AE%E8%A6%B3%E6%B8%AC%E8%A1%9B%E6%98%9F%E6%89%93%E3%81%A1%E4%B8%8A%E3%81%92%EF%BD%9Clazy_kojocho&related=note_PR","note_url":"https://note.com/lazy_kojocho/n/ncc796712f232","twitter_related_accounts":"note_PR","tweet_text":"SE 47h: はじめての観測衛星打ち上げ｜lazy_kojocho","circle_plans":[],"is_public_membership_connected":false,"is_board_disabled":false,"discount_campaigns":[],"lead_form":null,"line_add_friend":null,"line_add_friend_note_enable_feature":false,"note_share_total_count":0,"note_share_provider_details":{},"is_published_preview_note":false,"is_ratable":false,"content_rating_via":"","content_raters":[],"my_rating_exists":false,"rater_count":0,"is_recently_purchased":false,"requires_login_for_purchase":false,"is_recently_tip":false,"exclude_from_creator_top":false,"exclude_ai_learning_reward":true,"translation_setting":null,"is_related_with_investment":false,"related_stocks":[],"translation":{"available_languages":[]}}}